<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>it.tidalwave.superpom</groupId>
        <artifactId>superpom</artifactId>
        <version>5.21</version>
        <relativePath />
    </parent>
    <groupId>it.tidalwave.steelblue</groupId>
    <artifactId>steelblue</artifactId>
    <version>3.0-ALPHA-6-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SteelBlue</name>
    <url>https://tidalwave.bitbucket.io/steelblue</url>
    <inceptionYear>2015</inceptionYear>
    <description>
SteelBlue contains a set of UI abstractions based on DCI roles and JavaFX bindings. It allows to create rich client applications in a way
that is mostly independent of the UI technology; so testing is easier, and it is possible to create applications with multiple user interfaces.
    </description>
    <!-- Repeated because of http://jira.codehaus.org/browse/SCM-442 -->
    <scm>
        <connection>scm:git:${scm.repo.readonly.url}</connection>
        <developerConnection>scm:git:${scm.repo.effective.url}</developerConnection>
        <url>${scm.repo.browse.url}</url>
        <tag>HEAD</tag>
    </scm>
    <distributionManagement>
        <site>
            <id>steelblue-site</id>
            <url>${tidalwave.project.url}</url>
        </site>
    </distributionManagement>
    <properties>
        <tft.maven.requiredJdk>[21, 22)</tft.maven.requiredJdk>
        <scm.repo.url>ssh://git@bitbucket.org/tidalwave/steelblue-src.git</scm.repo.url>
        <scm.repo.readonly.url>https://bitbucket.org/tidalwave/steelblue-src</scm.repo.readonly.url>
        <scm.repo.browse.url>https://bitbucket.org/tidalwave/steelblue-src/src</scm.repo.browse.url>
        <tidalwave.project.url>https://tidalwave.bitbucket.io/steelblue</tidalwave.project.url>
        <tidalwave.slogan>SteelBlue: DCI User Interfaces</tidalwave.slogan>
        <tidalwave.ci.view>SteelBlue</tidalwave.ci.view>
        <tidalwave.issues>STB</tidalwave.issues>
        <tidalwave.github.readonly.url>https://github.com/tidalwave-it/steelblue-src</tidalwave.github.readonly.url>
        <tidalwave.github.browse.url>https://github.com/tidalwave-it/steelblue-src</tidalwave.github.browse.url>
        <tft.revapi.skip>false</tft.revapi.skip>
        <!-- tft.revapi.skip=true must be kept in sync in excluded modules. -->
        <tft.revapi.aggregate.includedArtifacts>it\.tidalwave\.steelblue:.*</tft.revapi.aggregate.includedArtifacts>
        <tft.revapi.aggregate.excludedArtifacts>it\.tidalwave\.steelblue:it-tidalwave-ui-example.*:.*</tft.revapi.aggregate.excludedArtifacts>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- START SNIPPET: core -->
            <dependency>
                <groupId>it.tidalwave.steelblue</groupId>
                <artifactId>it-tidalwave-ui-core</artifactId>
                <version>3.0-ALPHA-6-SNAPSHOT</version>
            </dependency>
            <!-- END SNIPPET: core -->
            <dependency>
                <groupId>it.tidalwave.steelblue</groupId>
                <artifactId>it-tidalwave-ui-core</artifactId>
                <classifier>tests</classifier>
                <version>3.0-ALPHA-6-SNAPSHOT</version>
            </dependency>
            <!-- START SNIPPET: test -->
            <dependency>
                <groupId>it.tidalwave.steelblue</groupId>
                <artifactId>it-tidalwave-ui-test</artifactId>
                <version>3.0-ALPHA-6-SNAPSHOT</version>
            </dependency>
            <!-- END SNIPPET: test -->
            <!-- START SNIPPET: javafx -->
            <dependency>
                <groupId>it.tidalwave.steelblue</groupId>
                <artifactId>it-tidalwave-ui-javafx</artifactId>
                <version>3.0-ALPHA-6-SNAPSHOT</version>
            </dependency>
            <!-- END SNIPPET: javafx -->
            <dependency>
                <groupId>it.tidalwave.steelblue</groupId>
                <artifactId>it-tidalwave-ui-example-model</artifactId>
                <version>3.0-ALPHA-6-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>it.tidalwave.steelblue</groupId>
                <artifactId>it-tidalwave-ui-example-presentation</artifactId>
                <version>3.0-ALPHA-6-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>it.tidalwave.steelblue</groupId>
                <artifactId>it-tidalwave-ui-example-presentation-javafx</artifactId>
                <version>3.0-ALPHA-6-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <modules>
        <module>modules</module>
    </modules>
</project>
